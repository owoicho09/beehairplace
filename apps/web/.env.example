# --- Supabase ---
# Project URL and keys: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (Supabase dashboard -> Project Settings -> Database -> Connection string -> URI)
# Use the "Transaction pooler" connection (port 6543) for serverless deployments.
DATABASE_URL=

# Same dashboard page, "Session pooler" mode (port 5432) instead of Transaction.
# Only used by `npm run db:migrate` / `db:generate` — Supabase's transaction
# pooler doesn't support the session-level locking migrations need.
SUPABASE_SESSION_POOLER=

# --- Supabase Storage buckets ---
# Private bucket for raw uploaded videos before processing.
SUPABASE_RAW_MEDIA_BUCKET=raw-media
# Public bucket for processed video/poster output served to the storefront.
SUPABASE_PUBLIC_MEDIA_BUCKET=media

# --- Paystack ---
# Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Admin auth ---
# Random 32+ byte secret used to sign the admin session cookie, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=
# Seed values used only by `npm run create-admin` to create the single admin user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Media processing worker ---
# Base URL of the deployed media-worker service (see apps/media-worker).
MEDIA_WORKER_URL=
# Shared secret the web app and worker use to authenticate calls to each other.
MEDIA_WORKER_SECRET=

# Random secret used to authenticate the daily media-cleanup cron request
# (e.g. Vercel Cron calling /api/cron/media-cleanup), e.g. `openssl rand -base64 32`
CRON_SECRET=

# --- Site ---
# Canonical site URL, used for Paystack callback URLs and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
